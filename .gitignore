_*.mjs
_*.cjs
_to_delete/

# Production membership dumps and environment fixtures.
# Both carry real people's email addresses and platform user ids. Excluded from a
# public repository by default; see README-GIT-NOTES if you need them tracked in a
# private mirror instead.
postgres/backup/
environments/

# Internal analysis and production review evidence — kept on disk, out of the
# public repository.
#
# The two documents below assess what KIRIA's client agreements and published
# policies do and do not permit; the screenshots show real client names, staff
# addresses and production document titles. None of it is secret, and none of it
# belongs in a public repository either.
apps/compass-insights/DISCLOSURE-GATE.md
apps/compass-insights/WHAT-WE-NEED-AND-WHY.md
artifacts/

# Microsoft Office lock files. Word writes `~$name.docx` beside an open document
# and deletes it on close, so one tracked by accident shows up as a phantom
# deletion later — which is exactly how it was noticed.
~$*
