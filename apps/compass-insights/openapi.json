{
  "openapi": "3.1.0",
  "info": {
    "title": "App Backend API",
    "version": "1.0.0",
    "description": "Public callable API for this Fusebase app."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns the backend health status.",
        "x-fusebase-visibility": "org",
        "x-fusebase-execution-mode": "sync",
        "responses": {
          "200": {
            "description": "Backend is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
